# Copy this file to .env and fill in. .env is git-ignored - never commit real secrets.

# Supabase: Project Settings -> Database -> Connection string -> "Session pooler" (URI).
# Leave empty to use the local SQLite file in data/.
DATABASE_URL=

# Load demo accounts + a week of test orders on startup when the database is empty (1 = yes).
COURIER_SEED_DEMO=0

# MMG: "mock" until the real API is wired into app/payments.py (LiveMMG).
COURIER_MMG_MODE=mock
MMG_API_BASE=
MMG_MERCHANT_ID=
MMG_API_KEY=
MMG_CALLBACK_SECRET=
